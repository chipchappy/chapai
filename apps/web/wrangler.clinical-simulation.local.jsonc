{
  // Local-only Clinical Simulation worker. This file has no routes or remote resources.
  "name": "chapai-clinical-simulation-local",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chapai-clinical-simulation-local",
      "database_id": "00000000-0000-0000-0000-000000000007"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "CLINICAL_SIMULATION_ENABLED": "true",
    "NEXTAUTH_URL": "https://127.0.0.1:8788",
    "NEXT_PUBLIC_APP_URL": "https://127.0.0.1:8788"
  }
}
